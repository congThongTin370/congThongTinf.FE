@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var vi = new System.Globalization.CultureInfo("vi-VN");
    var today = DateTime.Now;
    var dayName = vi.TextInfo.ToTitleCase(vi.DateTimeFormat.GetDayName(today.DayOfWeek));
    var tickerDate = $"{dayName}, {today:dd/MM/yyyy}";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cổng thông tin Sư đoàn 370</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/congThongTinf.FE.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="site-banner">
            <div class="site-container">
                <a class="site-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="site-emblem" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 78 52" width="78" height="52">
                            <path fill="currentColor" d="M39 18.2 33.6 26h-8.2L31.8 30 28.6 38 39 33.4 49.4 38 46.2 30 52.6 26h-8.2L39 18.2z" />
                            <path fill="currentColor" d="M4 27.5c7.2-3.4 16.4-5.2 24.2-5.2v3.2c-6.6.2-14.4 1.8-20.6 4.4L4 27.5zm70 0-3.6 2.4c-6.2-2.6-14-4.2-20.6-4.4v-3.2c7.8 0 17 1.8 24.2 5.2zM8.5 33.2c6.4-2.2 14.8-3.4 22.2-3.4v2.8c-6.4.2-13.4 1.3-18.8 3.1l-3.4-2.5zm61 0-3.4 2.5c-5.4-1.8-12.4-2.9-18.8-3.1v-2.8c7.4 0 15.8 1.2 22.2 3.4z" />
                            <circle cx="39" cy="30" r="3.1" fill="currentColor" />
                        </svg>
                    </span>
                    <span class="site-brand-text">
                        <span class="site-kicker">Cổng thông tin điện tử</span>
                        <span class="site-name">Sư đoàn Không quân 370</span>
                    </span>
                </a>
            </div>
        </div>

        <nav class="site-nav" aria-label="Điều hướng chính">
            <div class="site-container site-nav-bar">
                <input class="nav-toggle-input" type="checkbox" id="nav-toggle" />
                <label class="nav-toggle" for="nav-toggle">
                    <span class="nav-toggle-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Menu</span>
                </label>
                <ul class="site-nav-list">
                    <li>
                        <a class="nav-home @(currentController == "Home" && currentAction == "Index" ? "is-active" : null)" asp-area="" asp-controller="Home" asp-action="Index" aria-label="Trang chủ">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354z" />
                            </svg>
                        </a>
                    </li>
                    <li>
                        <a class="@(currentController == "Home" && currentAction == "Index" ? "is-active" : null)" asp-area="" asp-controller="Home" asp-action="Index">Tin tức</a>
                    </li>
                    <li>
                        <a class="@(currentAction == "Introduction" ? "is-active" : null)" asp-area="" asp-controller="Home" asp-action="Introduction">Giới thiệu</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Tài liệu</a>
                    </li>
                    <li>
                        <a class="@(currentAction == "Privacy" ? "is-active" : null)" asp-area="" asp-controller="Home" asp-action="Privacy">Liên kết</a>
                    </li>
                    <li>
                        <a asp-area="" asp-controller="Home" asp-action="Index">Kho phần mềm BQP</a>
                    </li>
                </ul>
                <div class="site-nav-tools">
                    <input class="search-toggle-input" type="checkbox" id="search-toggle" />
                    <label class="nav-tool" for="search-toggle" aria-label="Tìm kiếm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85zm-5.242.156a5 5 0 1 1 0-10 5 5 0 0 1 0 10" />
                        </svg>
                    </label>
                    <form class="nav-search" method="get" asp-controller="Home" asp-action="Index" role="search">
                        <label class="visually-hidden" for="site-search">Từ khóa</label>
                        <input id="site-search" name="q" type="search" placeholder="Tìm tin, tài liệu..." />
                    </form>
                    <a class="nav-tool @(currentAction == "Login" ? "is-active" : null)" asp-area="" asp-controller="Account" asp-action="Login" aria-label="Tài khoản">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m4-3a4 4 0 1 1-8 0 4 4 0 0 1 8 0M2 14s-1 0-1-1 1-4 7-4 7 3 7 4-1 1-1 1zm1.05-1h9.9a8 8 0 0 0-.56-1.31C11.8 10.9 10.2 10 8 10s-3.8.9-4.39 1.69A8 8 0 0 0 3.05 13" />
                        </svg>
                    </a>
                </div>
            </div>
        </nav>

        <div class="site-ticker">
            <div class="site-container site-ticker-bar">
                <p class="ticker-date">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M3.5 0a.5.5 0 0 1 .5.5V1h8V.5a.5.5 0 0 1 1 0V1h1a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V3a2 2 0 0 1 2-2h1V.5a.5.5 0 0 1 .5-.5M1 4v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V4z" />
                    </svg>
                    @tickerDate
                </p>
                <div class="ticker-marquee">
                    <ul class="ticker-list">
                        <li><a asp-controller="Home" asp-action="Index">Hội nghị quán triệt nhiệm vụ bảo vệ vùng trời phía Nam</a></li>
                        <li><a asp-controller="Home" asp-action="Index">Sư đoàn 370 kiểm tra công tác huấn luyện bay</a></li>
                        <li><a asp-controller="Home" asp-action="Introduction">Giới thiệu Sư đoàn Không quân 370</a></li>
                    </ul>
                    <ul class="ticker-list ticker-list-clone" aria-hidden="true">
                        <li><a asp-controller="Home" asp-action="Index" tabindex="-1">Hội nghị quán triệt nhiệm vụ bảo vệ vùng trời phía Nam</a></li>
                        <li><a asp-controller="Home" asp-action="Index" tabindex="-1">Sư đoàn 370 kiểm tra công tác huấn luyện bay</a></li>
                        <li><a asp-controller="Home" asp-action="Introduction" tabindex="-1">Giới thiệu Sư đoàn Không quân 370</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </header>

    <main class="site-main" role="main">
        <div class="site-container">
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="site-container site-footer-inner">
            <p class="site-footer-name">Cổng thông tin Sư đoàn Không quân 370</p>
            <p class="site-footer-copy">&copy; 2026 Sư đoàn Không quân 370</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
