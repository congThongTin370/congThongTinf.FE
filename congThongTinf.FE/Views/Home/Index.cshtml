@model List<congThongTinf.FE.Models.ApiModels.NewsDto>

@{
    var newsSearch = ViewData["NewsSearch"] as string;
    var isSearch = !string.IsNullOrWhiteSpace(newsSearch);
    ViewData["Title"] = isSearch ? "Tìm kiếm" : "Tin tức";
}

@if (isSearch)
{
    <section class="search-results" aria-labelledby="search-results-title">
        <header class="search-results-header">
            <h1 id="search-results-title" class="search-results-title">Kết quả tìm kiếm</h1>
            <form class="search-results-form" method="get" asp-controller="Home" asp-action="Index" role="search">
                <label class="visually-hidden" for="result-search">Tiêu đề</label>
                <input id="result-search" name="search" type="search" value="@newsSearch" placeholder="Tìm theo tiêu đề tin" />
                <button class="btn btn-primary" type="submit">Tìm</button>
            </form>
            <p class="search-results-count">
                @if (Model == null || Model.Count == 0)
                {
                    <span>Không có bài nào có tiêu đề chứa “@newsSearch”.</span>
                }
                else if (Model.Count == 1)
                {
                    <span>1 bài có tiêu đề chứa “@newsSearch”.</span>
                }
                else
                {
                    <span>@Model.Count bài có tiêu đề chứa “@newsSearch”.</span>
                }
            </p>
        </header>

        @if (Model == null || Model.Count == 0)
        {
            <p class="category-empty">Thử từ khóa khác, hoặc xem lại toàn bộ tin tức.</p>
            <p class="search-results-back"><a asp-controller="Home" asp-action="Index">Về trang tin tức</a></p>
        }
        else
        {
            <ul class="category-items">
                @foreach (var news in Model)
                {
                    <li class="category-item">
                        <a class="category-item-media" asp-controller="News" asp-action="Details" asp-route-id="@news.Id">
                            @if (!string.IsNullOrEmpty(news.CoverImageUrl))
                            {
                                <img src="@news.CoverImageUrl" alt="@news.Title" loading="lazy" />
                            }
                            else
                            {
                                <span class="category-item-placeholder" aria-hidden="true"></span>
                            }
                        </a>
                        <div class="category-item-body">
                            <h2 class="category-item-title">
                                <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id">@news.Title</a>
                            </h2>
                            @if (!string.IsNullOrEmpty(news.Summary))
                            {
                                <p class="category-item-summary">@news.Summary</p>
                            }
                            <p class="category-item-meta">
                                @if (!string.IsNullOrEmpty(news.CategoryName))
                                {
                                    <span>@news.CategoryName</span>
                                    <span aria-hidden="true">·</span>
                                }
                                @if (!string.IsNullOrEmpty(news.AuthorName))
                                {
                                    <span>@news.AuthorName</span>
                                    <span aria-hidden="true">·</span>
                                }
                                <time datetime="@news.CreatedAt.ToString("o")">@news.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</time>
                            </p>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>
}
else
{
<div class="home-layout">
    @if (ViewData["CategoryFilterActive"] is true)
    {
        <div class="home-filter-bar">
            <span>Chuyên mục:</span>
            <strong>@(ViewData["CategoryFilterName"] as string ?? "Đã chọn")</strong>
            <a asp-controller="Home" asp-action="Index">Xem tất cả</a>
        </div>
    }

    @if (Model != null && Model.Count > 0)
    {
        <!-- Main Feature: Tin mới nhất -->
        var latestNews = Model.FirstOrDefault();
        @if (latestNews != null)
        {
            <article class="home-feature">
                <a class="home-feature-media" asp-controller="News" asp-action="Details" asp-route-id="@latestNews.Id">
                    @{
                        var coverOverride = ViewData["LatestNewsCoverOverride"] as string;
                        var coverUrl = !string.IsNullOrWhiteSpace(coverOverride) ? coverOverride : latestNews.CoverImageUrl;
                    }
                    @if (!string.IsNullOrEmpty(coverUrl))
                    {
                        <img src="@coverUrl" alt="@latestNews.Title" loading="lazy" />
                    }
                    else
                    {
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" role="img" aria-label="Minh họa máy bay trên nền trời">
                            <defs>
                                <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                                    <stop offset="0" stop-color="#6FA9C9" />
                                    <stop offset="0.55" stop-color="#3F80A7" />
                                    <stop offset="1" stop-color="#2F6688" />
                                </linearGradient>
                            </defs>
                            <rect width="800" height="450" fill="url(#sky)" />
                            <ellipse cx="180" cy="120" rx="90" ry="28" fill="#fff" opacity="0.28" />
                            <ellipse cx="560" cy="90" rx="120" ry="32" fill="#fff" opacity="0.22" />
                            <path fill="#EAF4FA" d="M40 300c80-40 140-20 210 10 70 30 130 20 210-16 60-26 120-18 180 8 40 18 80 16 120-8v156H40V300z" opacity="0.18" />
                            <g fill="#F5F8FA">
                                <path d="M120 248 430 214l86 10-248 52-148-28z" />
                                <path d="M250 232 286 168l28 8-46 62z" />
                                <path d="M300 226 430 250l-18 16-96-28z" />
                                <path d="M168 242 92 286l22 8 78-36z" />
                            </g>
                        </svg>
                    }
                </a>
                <h1 class="home-feature-title">
                    <a asp-controller="News" asp-action="Details" asp-route-id="@latestNews.Id">@latestNews.Title</a>
                </h1>
            </article>
        }

        <!-- Highlights: Tin nổi bật (các tin tiếp theo) -->
        @if (Model.Count > 1)
        {
            <section class="home-highlights" aria-labelledby="highlight-title">
                <h2 id="highlight-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill="currentColor" d="M8 0l2.2 5.2L16 6l-4.2 3.6L13 16 8 12.8 3 16l1.2-6.4L0 6l5.8-.8z" />
                    </svg>
                    Tin nổi bật
                </h2>
                <ul>
                    @* Chỉ lấy 5 bài mới nhất (danh sách đã sắp xếp mới nhất trước) *@
                    @foreach (var news in Model.Skip(1).Take(5))
                    {
                        <li><a asp-controller="News" asp-action="Details" asp-route-id="@news.Id">@news.Title</a></li>
                    }
                </ul>
            </section>
        }
    }
    else
    {
        <!-- Fallback UI when no news available -->
        <article class="home-feature">
            <a class="home-feature-media" asp-controller="Home" asp-action="Introduction">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 450" role="img" aria-label="Minh họa máy bay trên nền trời">
                    <defs>
                        <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0" stop-color="#6FA9C9" />
                            <stop offset="0.55" stop-color="#3F80A7" />
                            <stop offset="1" stop-color="#2F6688" />
                        </linearGradient>
                    </defs>
                    <rect width="800" height="450" fill="url(#sky)" />
                    <ellipse cx="180" cy="120" rx="90" ry="28" fill="#fff" opacity="0.28" />
                    <ellipse cx="560" cy="90" rx="120" ry="32" fill="#fff" opacity="0.22" />
                    <path fill="#EAF4FA" d="M40 300c80-40 140-20 210 10 70 30 130 20 210-16 60-26 120-18 180 8 40 18 80 16 120-8v156H40V300z" opacity="0.18" />
                    <g fill="#F5F8FA">
                        <path d="M120 248 430 214l86 10-248 52-148-28z" />
                        <path d="M250 232 286 168l28 8-46 62z" />
                        <path d="M300 226 430 250l-18 16-96-28z" />
                        <path d="M168 242 92 286l22 8 78-36z" />
                    </g>
                </svg>
            </a>
            <h1 class="home-feature-title">
                <a asp-controller="Home" asp-action="Introduction">Sư đoàn Không quân 370 quán triệt nhiệm vụ bảo vệ vùng trời phía Nam</a>
            </h1>
        </article>

        <section class="home-highlights" aria-labelledby="highlight-title">
            <h2 id="highlight-title">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill="currentColor" d="M8 0l2.2 5.2L16 6l-4.2 3.6L13 16 8 12.8 3 16l1.2-6.4L0 6l5.8-.8z" />
                </svg>
                Tin nổi bật
            </h2>
            <ul>
                <li><a asp-controller="Home" asp-action="Introduction">Phát huy vai trò của Sư đoàn 370 trong thế trận bảo vệ vùng trời, vùng biển phía Nam</a></li>
                <li><a asp-controller="Home" asp-action="Index">Hội nghị giao ban công tác huấn luyện và sẵn sàng chiến đấu</a></li>
                <li><a asp-controller="Home" asp-action="Index">Trung đoàn 937 tổ chức bay huấn luyện tại sân bay Thành Sơn</a></li>
                <li><a asp-controller="Home" asp-action="Index">Trung đoàn 935 duy trì trực sẵn sàng chiến đấu tại Biên Hòa</a></li>
                <li><a asp-controller="Home" asp-action="Introduction">Ban Chỉ huy Sư đoàn làm việc với các cơ quan, đơn vị trực thuộc</a></li>
            </ul>
        </section>
    }

    <aside class="home-side">
        <a class="side-card side-card-cover" href="https://hochiminh.vn/" target="_blank" rel="noopener noreferrer">
            <img class="side-card-image" src="https://dangcongsan.vn/upload/2006988/20260701/bacho_0cc80.png" alt="Chủ tịch Hồ Chí Minh" loading="lazy" />
            <span class="side-card-heading">Hồ Chí Minh</span>
        </a>
        <a class="side-card side-card-cover" href="https://www.mod.gov.vn/" target="_blank" rel="noopener noreferrer">
            <img class="side-card-image" src="https://phongkhongkhongquan.vn/images/advert/139.jpg" alt="Cổng thông tin điện tử Bộ Quốc phòng" loading="lazy" />
        </a>
    </aside>
</div>

@await Component.InvokeAsync("BannerSlot", new { position = 1 })

@await Component.InvokeAsync("LeaderStrip")
}
