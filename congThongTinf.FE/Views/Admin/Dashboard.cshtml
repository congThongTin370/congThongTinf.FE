@using System.Text.Encodings.Web
@using System.Text.Json
@model AdminDashboardViewModel
@{
    Layout = "_AdminLayout";
    var data = Model.Data;

    string FileSizeText(long bytes)
    {
        if (bytes >= 1024L * 1024 * 1024)
        {
            return $"{bytes / (1024d * 1024 * 1024):0.#} GB";
        }

        if (bytes >= 1024L * 1024)
        {
            return $"{bytes / (1024d * 1024):0.#} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes} B";
    }

    string ChartJson()
    {
        if (data == null)
        {
            return "{}";
        }

        var days = data.NewsByDay.OrderBy(d => d.Date).ToList();
        var payload = new
        {
            newsByDay = new
            {
                labels = days.Select(d => d.Date.ToString("dd/MM")).ToList(),
                datasets = new object[]
                {
                    new { label = "Tin được tạo", data = days.Select(d => d.Created).ToList(), color = "#2563EB" },
                    new { label = "Tin được đăng", data = days.Select(d => d.Published).ToList(), color = "#38BDF8" }
                }
            },
            newsStatus = new
            {
                labels = new[] { "Đã đăng", "Lưu trữ" },
                data = new[]
                {
                    data.News.Draft + data.News.Pending + data.News.Published,
                    data.News.Archived
                },
                colors = new[] { "#059669", "#64748B" }
            },
            newsByCategory = new
            {
                horizontal = true,
                labels = data.NewsByCategory.OrderByDescending(c => c.Count).Select(c => c.CategoryName ?? "Chưa phân loại").ToList(),
                datasets = new object[]
                {
                    new { label = "Số bài", data = data.NewsByCategory.OrderByDescending(c => c.Count).Select(c => c.Count).ToList(), color = "#2563EB" }
                }
            },
            documentsByCategory = new
            {
                horizontal = true,
                labels = data.Documents.ByCategory.OrderByDescending(c => c.Count).Select(c => DocumentCategories.Label(c.Category)).ToList(),
                datasets = new object[]
                {
                    new { label = "Số tài liệu", data = data.Documents.ByCategory.OrderByDescending(c => c.Count).Select(c => c.Count).ToList(), color = "#102A43" }
                }
            },
            topViewedNews = new
            {
                horizontal = true,
                labels = data.TopViewedNews.Select(n => n.Title ?? "Không tiêu đề").ToList(),
                urls = data.TopViewedNews.Select(n => Url.Action("NewsDetails", "Admin", new { id = n.Id })).ToList(),
                datasets = new object[]
                {
                    new { label = "Lượt xem", data = data.TopViewedNews.Select(n => n.ViewCount).ToList(), color = "#2563EB" }
                }
            }
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions
        {
            PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
        return json.Replace("<", "\\u003c", StringComparison.Ordinal);
    }
}

<div class="admin-page-header">
    <div>
        <p class="admin-page-kicker">Cổng thông tin nội bộ</p>
        <h1 class="admin-page-title">Bảng điều khiển</h1>
    </div>
</div>

<section class="admin-panel dashboard-filter-panel" aria-labelledby="dashboard-filter-title">
    <div class="admin-panel-header">
        <h2 id="dashboard-filter-title">Khoảng thời gian hoạt động</h2>
    </div>
    <div class="admin-panel-body">
        <form method="get" asp-controller="Admin" asp-action="Dashboard" class="admin-dashboard-filter">
            <div class="admin-form-field">
                <label for="fromDate">Từ ngày</label>
                <input id="fromDate" name="fromDate" type="date" class="form-control" value="@Model.FromDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="admin-form-field">
                <label for="toDate">Đến ngày</label>
                <input id="toDate" name="toDate" type="date" class="form-control" value="@Model.ToDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="admin-dashboard-filter-actions">
                <button type="submit" class="btn btn-primary">Lọc dữ liệu</button>
                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Dashboard">30 ngày gần nhất</a>
            </div>
        </form>
        <p class="admin-field-hint admin-dashboard-hint">Các chỉ số tổng số là toàn bộ dữ liệu; biểu đồ theo ngày được lọc theo khoảng đã chọn.</p>
    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="admin-alert-error dashboard-error" role="alert">@Model.LoadError</div>
}

@if (data != null)
{
    <script type="application/json" id="dashboard-chart-data">@Html.Raw(ChartJson())</script>

    <section aria-label="Tổng quan">
        <div class="admin-stat-grid">
            <div class="admin-stat-card admin-stat-card-users">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3.8 19c.6-3 2.8-4.6 5.2-4.6S13.6 16 14.2 19"/><circle cx="17" cy="8.5" r="2.4"/><path d="M20.6 18.5c-.4-2.1-1.9-3.3-3.6-3.3"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Người dùng</p>
                    <p class="admin-stat-value">@data.Users.Total</p>
                    <a class="admin-stat-link" asp-controller="Admin" asp-action="Users">@data.Users.Active đang hoạt động · Quản lý</a>
                </div>
            </div>
            <div class="admin-stat-card admin-stat-card-news">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h12a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3V5z"/><path d="M8 9h8M8 13h6"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Tin tức</p>
                    <p class="admin-stat-value">@data.News.Total</p>
                    <a class="admin-stat-link" asp-controller="Admin" asp-action="News">@(data.News.Draft + data.News.Pending + data.News.Published) đã đăng · Quản lý</a>
                </div>
            </div>
            <div class="admin-stat-card admin-stat-card-documents">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h7l5 5V20a1.5 1.5 0 0 1-1.5 1.5H7A1.5 1.5 0 0 1 5.5 20V5A1.5 1.5 0 0 1 7 3.5z"/><path d="M14 3.5V9h5.5"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Tài liệu</p>
                    <p class="admin-stat-value">@data.Documents.Total</p>
                    <a class="admin-stat-link" asp-controller="Admin" asp-action="Documents">@(FileSizeText(data.Documents.TotalFileSize)) · Quản lý</a>
                </div>
            </div>
            <div class="admin-stat-card admin-stat-card-categories">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7.5h16M4 12h16M4 16.5h10"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Danh mục</p>
                    <p class="admin-stat-value">@data.Categories.Total</p>
                    <a class="admin-stat-link" asp-controller="Admin" asp-action="Categories">@data.Categories.Active đang hoạt động · Quản lý</a>
                </div>
            </div>
        </div>
    </section>

    <section class="admin-panel admin-section-gap" aria-labelledby="news-by-day-title">
        <div class="admin-panel-header">
            <h2 id="news-by-day-title">Hoạt động tin tức theo ngày</h2>
        </div>
        <div class="admin-panel-body chart-card">
            @if (data.NewsByDay.Count == 0)
            {
                <p class="admin-empty">Không có dữ liệu trong khoảng ngày này.</p>
            }
            else
            {
                <div class="chart-canvas-wrap chart-canvas-wrap-wide">
                    <canvas id="chart-news-by-day" aria-label="Biểu đồ tin tức theo ngày"></canvas>
                </div>
            }
        </div>
    </section>

    <div class="admin-panel-grid admin-section-gap">
        <section class="admin-panel" aria-labelledby="news-status-title">
            <div class="admin-panel-header">
                <h2 id="news-status-title">Trạng thái tin tức</h2>
            </div>
            <div class="admin-panel-body chart-card">
                <div class="chart-canvas-wrap chart-canvas-wrap-donut">
                    <canvas id="chart-news-status" aria-label="Tỉ lệ trạng thái tin"></canvas>
                </div>
            </div>
        </section>

        <section class="admin-panel" aria-labelledby="news-category-title">
            <div class="admin-panel-header">
                <h2 id="news-category-title">Tin theo danh mục</h2>
            </div>
            <div class="admin-panel-body chart-card">
                @if (data.NewsByCategory.Count == 0)
                {
                    <p class="admin-empty">Chưa có số liệu theo danh mục.</p>
                }
                else
                {
                    <div class="chart-canvas-wrap">
                        <canvas id="chart-news-by-category" aria-label="Tin theo danh mục"></canvas>
                    </div>
                }
            </div>
        </section>
    </div>

    <section class="admin-panel admin-section-gap" aria-labelledby="document-category-title">
        <div class="admin-panel-header">
            <h2 id="document-category-title">Tài liệu theo danh mục</h2>
        </div>
        <div class="admin-panel-body chart-card">
            @if (data.Documents.ByCategory.Count == 0)
            {
                <p class="admin-empty">Chưa có số liệu tài liệu.</p>
            }
            else
            {
                <div class="chart-canvas-wrap">
                    <canvas id="chart-documents-by-category" aria-label="Tài liệu theo danh mục"></canvas>
                </div>
            }
        </div>
    </section>

    <div class="admin-panel-grid admin-section-gap">
        <section class="admin-panel" aria-labelledby="top-news-title">
            <div class="admin-panel-header">
                <h2 id="top-news-title">Tin có lượt xem cao</h2>
            </div>
            <div class="admin-panel-body chart-card">
                @if (data.TopViewedNews.Count == 0)
                {
                    <p class="admin-empty">Chưa có dữ liệu lượt xem.</p>
                }
                else
                {
                    <div class="chart-canvas-wrap">
                        <canvas id="chart-top-news" aria-label="Tin có lượt xem cao"></canvas>
                    </div>
                    <p class="admin-field-hint">Bấm vào cột để xem chi tiết.</p>
                }
            </div>
        </section>

        <section class="admin-panel" aria-labelledby="recent-documents-title">
            <div class="admin-panel-header">
                <h2 id="recent-documents-title">Tài liệu mới tải lên</h2>
            </div>
            <div class="admin-panel-body">
                @if (data.RecentDocuments.Count == 0)
                {
                    <p class="admin-empty">Chưa có tài liệu.</p>
                }
                else
                {
                    <ul class="admin-list">
                        @foreach (var document in data.RecentDocuments)
                        {
                            <li>
                                <div>
                                    <div>@document.Title</div>
                                    <div class="admin-list-meta">@document.FileName · @DocumentCategories.Label(document.Category)</div>
                                </div>
                                <span class="admin-list-meta">@document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </section>
    </div>
}

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/admin-dashboard-charts.js" asp-append-version="true"></script>
}
