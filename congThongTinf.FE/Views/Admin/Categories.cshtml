@model List<CategoryDto>
@{
    Layout = "_AdminLayout";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Danh mục</h1>
    <a class="btn btn-primary btn-sm btn-with-icon" asp-controller="Admin" asp-action="CreateCategory" data-tip="Thêm chuyên mục tin trên cổng thông tin">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        Tạo danh mục
    </a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="admin-alert" role="status">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="admin-alert-error" role="alert">@error</div>
}

<p class="admin-form-status">Danh mục đang hiển thị trên cổng thông tin, sắp theo thứ tự rồi đến tên. Xóa danh mục chỉ ẩn mục đó. Danh mục còn bài báo thì chưa xóa được.</p>

<section class="admin-panel" aria-labelledby="category-list-title">
    <div class="admin-panel-header">
        <h2 id="category-list-title">Danh sách danh mục</h2>
    </div>
    <div class="admin-panel-body admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Tên</th>
                    <th scope="col">Thứ tự</th>
                    <th scope="col">Cập nhật</th>
                    <th scope="col" class="admin-table-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="admin-table-empty">Chưa có danh mục.</td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>
                                <strong>@category.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(category.Description))
                                {
                                    <div class="admin-table-sub">@category.Description</div>
                                }
                            </td>
                            <td>@category.DisplayOrder</td>
                            <td>@category.UpdatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="admin-table-actions">
                                <div class="admin-row-actions">
                                    <a class="admin-icon-btn" asp-controller="Admin" asp-action="EditCategory" asp-route-id="@category.Id" data-tip="Sửa tên, mô tả và thứ tự hiển thị" aria-label="Sửa @category.Name">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg>
                                    </a>
                                    <a class="admin-icon-btn admin-icon-btn-danger" asp-controller="Admin" asp-action="DeleteCategory" asp-route-id="@category.Id" data-tip="Ẩn danh mục khỏi cổng thông tin" aria-label="Xóa @category.Name">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M8 7l1 12h6l1-12"/></svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
