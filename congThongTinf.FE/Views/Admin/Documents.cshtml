@model DocumentListViewModel
@using System.Globalization
@{
    Layout = "_AdminLayout";
    var sizeCulture = CultureInfo.GetCultureInfo("vi-VN");

    string FileSizeText(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / (1024d * 1024d):0.#} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes} B";
    }

    string StorageSizeText(long bytes)
    {
        var value = bytes < 0 ? 0d : bytes;
        string[] units = ["B", "KB", "MB", "GB", "TB"];
        var unit = 0;
        while (value >= 1024 && unit < units.Length - 1)
        {
            value /= 1024;
            unit++;
        }

        var number = unit == 0
            ? value.ToString("0", sizeCulture)
            : value.ToString("0.#", sizeCulture);
        return $"{number} {units[unit]}";
    }

    string FileKind(string fileName)
    {
        var ext = System.IO.Path.GetExtension(fileName);
        return string.IsNullOrEmpty(ext) ? "—" : ext.TrimStart('.').ToUpperInvariant();
    }
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Tài liệu nội bộ</h1>
    <a class="btn btn-primary btn-sm" asp-controller="Admin" asp-action="UploadDocument">Tải lên tài liệu</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="admin-alert" role="status">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="admin-alert-error" role="alert">@error</div>
}

<section class="admin-panel" aria-labelledby="document-filter-title">
    <div class="admin-panel-header">
        <h2 id="document-filter-title">Tìm kiếm</h2>
    </div>
    <div class="admin-panel-body">
        <form method="get" asp-controller="Admin" asp-action="Documents" class="admin-filter">
            <div class="admin-form-field">
                <label for="search">Từ khóa</label>
                <input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Tiêu đề, tên tệp hoặc mô tả" />
            </div>
            <div class="admin-form-field">
                <label for="category">Danh mục</label>
                <select id="category" name="category" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var option in DocumentCategories.Options)
                    {
                        if (Model.Category == option.Value)
                        {
                            <option value="@option.Value" selected>@option.Label</option>
                        }
                        else
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    }
                </select>
            </div>
            <div class="admin-filter-actions">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Documents">Xóa lọc</a>
            </div>
        </form>
    </div>
</section>

<section class="admin-panel admin-section-gap" aria-labelledby="document-list-title">
    <div class="admin-panel-header">
        <h2 id="document-list-title">Danh sách tài liệu</h2>
    </div>
    <div class="admin-panel-body admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Tiêu đề</th>
                    <th scope="col">Danh mục</th>
                    <th scope="col">Tệp</th>
                    <th scope="col">Dung lượng</th>
                    <th scope="col">Người tải</th>
                    <th scope="col">Ngày tải</th>
                    <th scope="col" class="admin-table-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="admin-table-empty">Chưa có tài liệu phù hợp.</td>
                    </tr>
                }
                else
                {
                    @foreach (var document in Model.Items)
                    {
                        <tr>
                            <td>
                                <strong>@document.Title</strong>
                                @if (!string.IsNullOrWhiteSpace(document.Description))
                                {
                                    <div class="admin-table-sub">@document.Description</div>
                                }
                            </td>
                            <td><span class="admin-badge">@DocumentCategories.Label(document.Category)</span></td>
                            <td>@FileKind(document.FileName)</td>
                            <td>@FileSizeText(document.FileSize)</td>
                            <td>@(string.IsNullOrWhiteSpace(document.UploadedByUserName) ? "—" : document.UploadedByUserName)</td>
                            <td>@document.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="admin-table-actions">
                                <div class="admin-row-actions">
                                    @if (!string.IsNullOrWhiteSpace(document.FileUrl))
                                    {
                                        <a class="admin-icon-btn" href="@document.FileUrl" target="_blank" rel="noopener" aria-label="Xem @document.Title" title="Xem">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.8"/></svg>
                                        </a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(document.DownloadUrl))
                                    {
                                        <a class="admin-icon-btn" href="@document.DownloadUrl" download="@document.FileName" aria-label="Tải xuống @document.Title" title="Tải xuống">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11"/><path d="M7.5 10.5L12 15l4.5-4.5"/><path d="M5 19.5h14"/></svg>
                                        </a>
                                    }
                                    <form class="admin-inline-form" method="post"
                                          asp-controller="Admin"
                                          asp-action="DeleteDocument"
                                          asp-route-id="@document.Id"
                                          asp-route-search="@Model.Search"
                                          asp-route-category="@Model.Category"
                                          asp-route-pageIndex="@Model.PageIndex"
                                          data-confirm-delete
                                          data-document-title="@document.Title">
                                        <button type="submit" class="admin-icon-btn admin-icon-btn-danger" aria-label="Xóa @document.Title" title="Xóa">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M8 7l1 12h6l1-12"/></svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@if (Model.HasPrevious || Model.HasNext)
{
    <nav class="admin-pagination" aria-label="Phân trang tài liệu">
        @if (Model.HasPrevious)
        {
            <a class="btn btn-outline-secondary btn-sm"
               asp-controller="Admin"
               asp-action="Documents"
               asp-route-search="@Model.Search"
               asp-route-category="@Model.Category"
               asp-route-pageIndex="@(Model.PageIndex - 1)">Trang trước</a>
        }
        <span class="admin-pagination-status">Trang @Model.PageIndex</span>
        @if (Model.HasNext)
        {
            <a class="btn btn-outline-secondary btn-sm"
               asp-controller="Admin"
               asp-action="Documents"
               asp-route-search="@Model.Search"
               asp-route-category="@Model.Category"
               asp-route-pageIndex="@(Model.PageIndex + 1)">Trang sau</a>
        }
    </nav>
}

<section class="admin-panel admin-section-gap" aria-labelledby="storage-title">
    <div class="admin-panel-header">
        <h2 id="storage-title">Dung lượng lưu trữ</h2>
    </div>
    <div class="admin-panel-body">
        @if (!Model.Storage.Success || Model.Storage.Data == null)
        {
            <p class="admin-alert-error storage-error" role="alert">@Model.Storage.ErrorMessage</p>
        }
        else
        {
            var usage = Model.Storage.Data;
            var fill = Math.Clamp(usage.UsedPercent, 0, 100).ToString("0.##", CultureInfo.InvariantCulture);
            var overQuota = usage.UsedPercent >= 100;
            <div class="storage-meter">
                <p class="storage-headline">
                    <strong>@StorageSizeText(usage.UsedBytes)</strong>
                    <span>đã dùng trong @StorageSizeText(usage.QuotaBytes)</span>
                </p>
                <div class="storage-track" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@fill" aria-label="Phần trăm dung lượng đã dùng">
                    <span class="storage-fill@(overQuota ? " is-full" : "")" style="width: @(fill)%"></span>
                </div>
                <ul class="storage-legend">
                    <li><span class="storage-dot storage-dot-used@(overQuota ? " is-full" : "")" aria-hidden="true"></span>Đã dùng @StorageSizeText(usage.UsedBytes)</li>
                    <li><span class="storage-dot storage-dot-free" aria-hidden="true"></span>Còn lại @StorageSizeText(usage.RemainingBytes)</li>
                    <li>@usage.UsedPercent.ToString("0.##", sizeCulture)%</li>
                </ul>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('form[data-confirm-delete]').forEach(function (form) {
            form.addEventListener('submit', function (e) {
                if (form.dataset.confirmed) return;
                e.preventDefault();
                AppDialog.confirm({
                    title: 'Xóa tài liệu?',
                    message: '“' + form.dataset.documentTitle + '” sẽ bị xóa khỏi cổng thông tin và không thể khôi phục.',
                    okText: 'Xóa',
                    danger: true
                }).then(function (ok) {
                    if (!ok) return;
                    form.dataset.confirmed = 'true';
                    form.submit();
                });
            });
        });
    </script>
}
