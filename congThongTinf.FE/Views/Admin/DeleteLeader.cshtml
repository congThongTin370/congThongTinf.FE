@model LeaderDto
@{
    Layout = "_AdminLayout";
}

<section class="admin-panel" aria-labelledby="delete-leader-title">
    <div class="admin-panel-header">
        <h2 id="delete-leader-title">Xác nhận xóa thủ trưởng</h2>
    </div>
    <div class="admin-panel-body">
        <p class="admin-form-status">Thủ trưởng và ảnh lưu trữ sẽ bị xóa, không còn hiện trên dải lãnh đạo trang chủ. Thao tác này không hoàn tác được.</p>
        <p class="admin-confirm-title"><strong>@Model.Rank @Model.FullName</strong></p>
        <p class="admin-form-status">@Model.Position</p>

        <div class="admin-form-actions">
            <form asp-controller="Admin" asp-action="DeleteLeader" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </form>
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Leaders">Hủy</a>
        </div>
    </div>
</section>
