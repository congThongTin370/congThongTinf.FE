@model BannerFormViewModel
@{
    Layout = "_AdminLayout";
    var heading = Model.IsEdit ? "Sửa banner" : "Tải banner";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">@heading</h1>
    <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="Banners">Quay lại danh sách</a>
</div>

<section class="admin-panel" aria-labelledby="banner-form-title">
    <div class="admin-panel-header">
        <h2 id="banner-form-title">Thông tin banner</h2>
    </div>
    <div class="admin-panel-body">
        @if (Model.IsEdit)
        {
            <p class="admin-form-status">Để trống tệp nếu giữ ảnh hiện tại. Tiêu đề không được để trống. Ảnh mới được lưu thành WebP, tối đa 10 MB, cạnh tối đa 8192 px. Bật “Đang hiện” thì banner này thay banner đang hiện của cùng vị trí.</p>
        }
        else
        {
            <p class="admin-form-status">Ảnh được lưu thành WebP, tối đa 10 MB, cạnh tối đa 8192 px. Để trống tiêu đề sẽ lấy tên tệp. Bỏ chọn “Đang hiện” nếu chỉ thêm vào kho. Bật thì banner này thay banner đang hiện của cùng vị trí.</p>
        }

        <form asp-controller="Admin" asp-action="@(Model.IsEdit ? "EditBanner" : "CreateBanner")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="admin-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
            <input type="hidden" asp-for="CurrentImageUrl" />
            <input type="hidden" asp-for="CurrentFileName" />

            @if (Model.IsEdit && !string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
            {
                <div class="admin-form-field">
                    <span class="admin-field-label">Ảnh hiện tại</span>
                    <img class="admin-banner-preview" src="@Model.CurrentImageUrl" alt="@(string.IsNullOrWhiteSpace(Model.Title) ? "Banner hiện tại" : Model.Title)" />
                    @if (!string.IsNullOrWhiteSpace(Model.CurrentFileName))
                    {
                        <span class="admin-field-hint">@Model.CurrentFileName</span>
                    }
                </div>
            }

            <div class="admin-form-field">
                <label asp-for="File"></label>
                <input asp-for="File" class="form-control" type="file" accept="image/*" />
                <span class="admin-field-hint">Nhận ảnh (jpg, png, webp, gif, bmp, tiff…). Server lưu thành WebP. Tối đa 10 MB, cạnh tối đa 8192 px.</span>
                <span asp-validation-for="File" class="field-validation-error"></span>
            </div>

            <div class="admin-form-field">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" placeholder="@(Model.IsEdit ? "" : "Để trống sẽ lấy tên tệp")" />
                <span asp-validation-for="Title" class="field-validation-error"></span>
            </div>

            <div class="admin-form-field">
                <label asp-for="Position"></label>
                <select asp-for="Position" class="form-select">
                    @foreach (var option in BannerPositions.Options)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
                <span class="admin-field-hint">Header hiện trên mọi trang. Dải giữa trang chủ nằm dưới tin nổi bật.</span>
                <span asp-validation-for="Position" class="field-validation-error"></span>
            </div>

            <div class="admin-form-field">
                <label asp-for="LinkUrl"></label>
                <input asp-for="LinkUrl" class="form-control" maxlength="1000" placeholder="https://" />
                <span class="admin-field-hint">Để trống nếu banner không dẫn đi đâu. Tối đa 1000 ký tự.</span>
                <span asp-validation-for="LinkUrl" class="field-validation-error"></span>
            </div>

            <div class="admin-form-field">
                <label class="admin-check">
                    <input asp-for="IsActive" />
                    <span>Đang hiện ở vị trí này</span>
                </label>
                <span class="admin-field-hint">Bật thì các banner khác cùng vị trí bị tắt. Vị trí còn lại không đổi.</span>
            </div>

            <div class="admin-form-actions">
                <button type="submit" class="btn btn-primary">@(Model.IsEdit ? "Lưu thay đổi" : "Tải lên")</button>
                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Banners">Hủy</a>
            </div>
        </form>

        @if (Model.IsEdit && Model.Id.HasValue && !Model.IsActive)
        {
            <form class="admin-form-actions" asp-controller="Admin" asp-action="SetBannerActive" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-outline-secondary">Dùng cho vị trí này</button>
            </form>
        }
        else if (Model.IsEdit && Model.IsActive)
        {
            <p class="admin-form-status"><span class="admin-badge admin-badge-success">Đang hiện</span></p>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
