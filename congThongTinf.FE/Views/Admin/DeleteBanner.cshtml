@model BannerDto
@{
    Layout = "_AdminLayout";
}

<section class="admin-panel" aria-labelledby="delete-banner-title">
    <div class="admin-panel-header">
        <h2 id="delete-banner-title">Xác nhận xóa banner</h2>
    </div>
    <div class="admin-panel-body">
        <p class="admin-form-status">Banner và file ảnh sẽ bị xóa khỏi cổng thông tin. Thao tác này không hoàn tác được.</p>
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img class="admin-banner-preview" src="@Model.ImageUrl" alt="" />
        }
        <p class="admin-confirm-title"><strong>@(string.IsNullOrWhiteSpace(Model.Title) ? Model.FileName : Model.Title)</strong></p>
        <p class="admin-form-status">@BannerPositions.Label(Model.Position)@(Model.IsActive ? " · Đang hiện" : "")</p>
        @if (!string.IsNullOrWhiteSpace(Model.FileName))
        {
            <p class="admin-form-status">@Model.FileName</p>
        }

        <div class="admin-form-actions">
            <form asp-controller="Admin" asp-action="DeleteBanner" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
            </form>
            <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Banners">Hủy</a>
        </div>
    </div>
</section>
