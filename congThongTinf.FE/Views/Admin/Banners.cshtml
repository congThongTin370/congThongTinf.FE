@model BannerListViewModel
@{
    Layout = "_AdminLayout";

    BannerDto? ActiveOf(int position) => Model.Items
        .FirstOrDefault(item => item.Position == position && item.IsActive && !string.IsNullOrWhiteSpace(item.ImageUrl));

    var headerActive = ActiveOf(BannerPositions.Header);
    var midActive = ActiveOf(BannerPositions.HomeMid);
    var selected = Model.Position;
    var pool = selected.HasValue
        ? Model.Items.Where(item => item.Position == selected.Value).ToList()
        : new List<BannerDto>();

    if (selected.HasValue && !string.IsNullOrWhiteSpace(Model.Search))
    {
        var term = Model.Search.Trim();
        pool = pool.Where(item =>
                (item.Title ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase)
                || (item.FileName ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Sơ đồ banner</h1>
</div>

@if (TempData["Message"] is string message)
{
    <div class="admin-alert" role="status">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="admin-alert-error" role="alert">@error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="admin-alert-error" role="alert">@Model.LoadError</div>
}

<p class="admin-form-status">Bấm một ô trên sơ đồ để xem ảnh của vị trí đó và chọn ảnh sẽ gắn vào. Mỗi ô chỉ một banner đang hiện.</p>

<section class="banner-map" aria-labelledby="banner-map-title">
    <h2 id="banner-map-title" class="banner-map-title">Trang cổng thông tin</h2>
    <div class="banner-map-sheet">
        <a class="banner-zone banner-zone-header @(selected == BannerPositions.Header ? "is-selected" : null)"
           asp-controller="Admin"
           asp-action="Banners"
           asp-route-position="@(selected == BannerPositions.Header ? null : BannerPositions.Header)"
           asp-route-search="@Model.Search"
           aria-current="@(selected == BannerPositions.Header ? "true" : null)">
            <span class="banner-zone-tag">Header</span>
            @if (headerActive != null)
            {
                <img src="@headerActive.ImageUrl" alt="@headerActive.Title" />
                <span class="banner-zone-caption">@headerActive.Title</span>
            }
            else
            {
                <span class="banner-zone-empty">Trống · bấm để gắn</span>
            }
        </a>

        <div class="banner-map-nav" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
        </div>

        <div class="banner-map-news" aria-hidden="true">
            <div class="banner-map-feature"></div>
            <div class="banner-map-list">
                <span></span><span></span><span></span>
            </div>
            <div class="banner-map-side">
                <span></span><span></span>
            </div>
        </div>

        <a class="banner-zone banner-zone-mid @(selected == BannerPositions.HomeMid ? "is-selected" : null)"
           asp-controller="Admin"
           asp-action="Banners"
           asp-route-position="@(selected == BannerPositions.HomeMid ? null : BannerPositions.HomeMid)"
           asp-route-search="@Model.Search"
           aria-current="@(selected == BannerPositions.HomeMid ? "true" : null)">
            <span class="banner-zone-tag">Dải giữa</span>
            @if (midActive != null)
            {
                <img src="@midActive.ImageUrl" alt="@midActive.Title" />
                <span class="banner-zone-caption">@midActive.Title</span>
            }
            else
            {
                <span class="banner-zone-empty">Trống · bấm để gắn</span>
            }
        </a>

        <div class="banner-map-leaders" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
    </div>

    <ul class="banner-map-legend">
        <li><i class="banner-swatch banner-swatch-header"></i> Header — đầu mọi trang</li>
        <li><i class="banner-swatch banner-swatch-mid"></i> Dải giữa — dưới tin nổi bật, chỉ trang chủ</li>
    </ul>
</section>

@if (selected.HasValue)
{
    var zoneName = BannerPositions.Label(selected.Value);
    <section class="admin-panel admin-section-gap" aria-labelledby="banner-pool-title">
        <div class="admin-panel-header banner-pool-header">
            <h2 id="banner-pool-title">Ảnh cho @zoneName</h2>
            <a class="btn btn-primary btn-sm" asp-controller="Admin" asp-action="CreateBanner" asp-route-position="@selected">Tải ảnh vào ô này</a>
        </div>
        <div class="admin-panel-body">
            <form method="get" asp-controller="Admin" asp-action="Banners" class="banner-pool-search">
                <input type="hidden" name="position" value="@selected" />
                <label class="visually-hidden" for="search">Tìm ảnh</label>
                <input id="search" name="search" class="form-control" value="@Model.Search" placeholder="Tìm theo tiêu đề" />
                <button type="submit" class="btn btn-outline-secondary">Tìm</button>
            </form>

            @if (pool.Count == 0)
            {
                <p class="admin-table-empty">Chưa có ảnh cho vị trí này.</p>
            }
            else
            {
                <ul class="banner-seat-grid">
                    @foreach (var banner in pool)
                    {
                        <li class="banner-seat @(banner.IsActive ? "is-live" : null)">
                            @if (!string.IsNullOrWhiteSpace(banner.ImageUrl))
                            {
                                <img src="@banner.ImageUrl" alt="" />
                            }
                            else
                            {
                                <div class="banner-seat-missing">Không có ảnh</div>
                            }
                            <div class="banner-seat-body">
                                <strong>@(string.IsNullOrWhiteSpace(banner.Title) ? banner.FileName : banner.Title)</strong>
                                @if (banner.IsActive)
                                {
                                    <span class="admin-badge admin-badge-success">Đang gắn</span>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="SetBannerActive" asp-route-id="@banner.Id" method="post">
                                        <button type="submit" class="btn btn-primary btn-sm">Dùng cho vị trí này</button>
                                    </form>
                                }
                                <div class="banner-seat-actions">
                                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Admin" asp-action="EditBanner" asp-route-id="@banner.Id">Sửa</a>
                                    <a class="btn btn-danger btn-sm" asp-controller="Admin" asp-action="DeleteBanner" asp-route-id="@banner.Id">Xóa</a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}
else
{
    <p class="banner-map-hint">Chọn ô Header hoặc Dải giữa trên sơ đồ.</p>
}
