@model BannerListViewModel
@{
    Layout = "_AdminLayout";

    BannerDto? ActiveOf(int position) => Model.Items
        .FirstOrDefault(item => item.Position == position && item.IsActive && !string.IsNullOrWhiteSpace(item.ImageUrl));

    var headerActive = ActiveOf(BannerPositions.Header);
    var midActive = ActiveOf(BannerPositions.HomeMid);
    var selected = Model.Position;
    var zones = new[] { BannerPositions.Header, BannerPositions.HomeMid };
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Sơ đồ banner</h1>
</div>

@if (TempData["Message"] is string message)
{
    <div class="admin-alert" role="status">@message</div>
}

@if (TempData["Error"] is string error)
{
    <div class="admin-alert-error" role="alert">@error</div>
}

@if (!string.IsNullOrWhiteSpace(Model.LoadError))
{
    <div class="admin-alert-error" role="alert">@Model.LoadError</div>
}

<p class="admin-form-status">Bấm một ô trên sơ đồ để xem ảnh của vị trí đó và chọn ảnh sẽ gắn vào. Mỗi ô chỉ một banner đang hiện.</p>

<section class="banner-map" aria-labelledby="banner-map-title">
    <h2 id="banner-map-title" class="banner-map-title">Trang cổng thông tin</h2>
    <div class="banner-map-sheet">
        <button type="button"
                class="banner-zone banner-zone-header @(selected == BannerPositions.Header ? "is-selected" : null)"
                data-banner-zone="@BannerPositions.Header"
                aria-pressed="@(selected == BannerPositions.Header ? "true" : "false")">
            <span class="banner-zone-tag">Header</span>
            @if (headerActive != null)
            {
                <img src="@headerActive.ImageUrl" alt="@headerActive.Title" />
                <span class="banner-zone-caption">@headerActive.Title</span>
            }
            else
            {
                <span class="banner-zone-empty">Trống · bấm để gắn</span>
            }
        </button>

        <div class="banner-map-nav" aria-hidden="true">
            <span></span><span></span><span></span><span></span>
        </div>

        <div class="banner-map-news" aria-hidden="true">
            <div class="banner-map-feature"></div>
            <div class="banner-map-list">
                <span></span><span></span><span></span>
            </div>
            <div class="banner-map-side">
                <span></span><span></span>
            </div>
        </div>

        <button type="button"
                class="banner-zone banner-zone-mid @(selected == BannerPositions.HomeMid ? "is-selected" : null)"
                data-banner-zone="@BannerPositions.HomeMid"
                aria-pressed="@(selected == BannerPositions.HomeMid ? "true" : "false")">
            <span class="banner-zone-tag">Dải giữa</span>
            @if (midActive != null)
            {
                <img src="@midActive.ImageUrl" alt="@midActive.Title" />
                <span class="banner-zone-caption">@midActive.Title</span>
            }
            else
            {
                <span class="banner-zone-empty">Trống · bấm để gắn</span>
            }
        </button>

        <div class="banner-map-leaders" aria-hidden="true">
            <span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
    </div>

    <ul class="banner-map-legend">
        <li><i class="banner-swatch banner-swatch-header"></i> Header — đầu mọi trang</li>
        <li><i class="banner-swatch banner-swatch-mid"></i> Dải giữa — dưới tin nổi bật, chỉ trang chủ</li>
    </ul>
</section>

<p class="banner-map-hint" data-banner-hint @(selected.HasValue ? "hidden" : null)>Chọn ô Header hoặc Dải giữa trên sơ đồ.</p>

@foreach (var position in zones)
{
    var zoneName = BannerPositions.Label(position);
    var pool = Model.Items.Where(item => item.Position == position).ToList();
    var isOpen = selected == position;
    <section class="admin-panel admin-section-gap" data-banner-pool="@position" aria-labelledby="banner-pool-@position" @(isOpen ? null : "hidden")>
        <div class="admin-panel-header banner-pool-header">
            <h2 id="banner-pool-@position">Ảnh cho @zoneName</h2>
            <a class="btn btn-primary btn-sm" asp-controller="Admin" asp-action="CreateBanner" asp-route-position="@position">Tải ảnh vào ô này</a>
        </div>
        <div class="admin-panel-body">
            <div class="banner-pool-search">
                <label class="visually-hidden" for="search-@position">Tìm ảnh</label>
                <input id="search-@position" class="form-control" data-banner-search="@position" placeholder="Tìm theo tiêu đề" />
            </div>

            @if (pool.Count == 0)
            {
                <p class="admin-table-empty">Chưa có ảnh cho vị trí này.</p>
            }
            else
            {
                <ul class="banner-seat-grid">
                    @foreach (var banner in pool)
                    {
                        var title = string.IsNullOrWhiteSpace(banner.Title) ? banner.FileName : banner.Title;
                        <li class="banner-seat @(banner.IsActive ? "is-live" : null)" data-title="@title">
                            @if (!string.IsNullOrWhiteSpace(banner.ImageUrl))
                            {
                                <img src="@banner.ImageUrl" alt="" />
                            }
                            else
                            {
                                <div class="banner-seat-missing">Không có ảnh</div>
                            }
                            <div class="banner-seat-body">
                                <strong>@title</strong>
                                @if (banner.IsActive)
                                {
                                    <span class="admin-badge admin-badge-success">Đang gắn</span>
                                }
                                else
                                {
                                    <form asp-controller="Admin" asp-action="SetBannerActive" asp-route-id="@banner.Id" method="post">
                                        <button type="submit" class="btn btn-primary btn-sm">Dùng cho vị trí này</button>
                                    </form>
                                }
                                <div class="banner-seat-actions">
                                    <a class="admin-icon-btn" asp-controller="Admin" asp-action="EditBanner" asp-route-id="@banner.Id" aria-label="Sửa @title" title="Sửa">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/></svg>
                                    </a>
                                    <a class="admin-icon-btn admin-icon-btn-danger" asp-controller="Admin" asp-action="DeleteBanner" asp-route-id="@banner.Id" aria-label="Xóa @title" title="Xóa">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16"/><path d="M9 7V5h6v2"/><path d="M8 7l1 12h6l1-12"/></svg>
                                    </a>
                                </div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </section>
}

<section class="admin-panel admin-section-gap" aria-labelledby="banner-files-title">
    <div class="admin-panel-header">
        <h2 id="banner-files-title">Ảnh trong thư mục banners</h2>
    </div>
    <div class="admin-panel-body">
        @if (!string.IsNullOrWhiteSpace(Model.FilesError))
        {
            <p class="admin-alert-error" role="alert">@Model.FilesError</p>
        }
        else if (Model.Files.Count == 0)
        {
            <p class="admin-table-empty">Chưa có ảnh trong thư mục banners.</p>
        }
        else
        {
            <ul class="banner-seat-grid">
                @foreach (var file in Model.Files)
                {
                    var name = string.IsNullOrWhiteSpace(file.Key) ? file.Url : file.Key.Split('/').Last();
                    <li class="banner-seat">
                        @if (!string.IsNullOrWhiteSpace(file.Url))
                        {
                            <img src="@file.Url" alt="@name" />
                        }
                        <div class="banner-seat-body">
                            <strong>@name</strong>
                            <span class="admin-list-meta">
                                @if (file.Size >= 1024 * 1024)
                                {
                                    @($"{file.Size / (1024d * 1024d):0.#} MB")
                                }
                                else if (file.Size >= 1024)
                                {
                                    @($"{file.Size / 1024d:0.#} KB")
                                }
                                else
                                {
                                    @($"{file.Size} B")
                                }
                                @if (file.LastModified.HasValue)
                                {
                                    <span> · @file.LastModified.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                }
                            </span>
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/banner-map.js" asp-append-version="true"></script>
}
