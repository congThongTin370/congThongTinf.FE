@model List<congThongTinf.FE.Models.ApiModels.NewsDto>
@{
    Layout = "_JournalistLayout";
    ViewData["Title"] = "Quản lý bài báo";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Quản lý bài báo</h1>
    <a class="btn btn-primary btn-sm" asp-controller="Journalist" asp-action="Create">Viết bài mới</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="admin-alert" role="status">@message</div>
}

<section class="admin-panel" aria-labelledby="articles-title">
    <div class="admin-panel-header">
        <h2 id="articles-title">Danh sách bài báo</h2>
    </div>
    <div class="admin-panel-body admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Tiêu đề</th>
                    <th scope="col">Chuyên mục</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col">Cập nhật</th>
                    <th scope="col" class="admin-table-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="admin-table-empty">Bạn chưa có bài báo nào.</td>
                    </tr>
                }
                else
                {
                    @foreach (var news in Model)
                    {
                        <tr>
                            <td><a asp-controller="News" asp-action="Details" asp-route-id="@news.Id">@news.Title</a></td>
                            <td>@news.CategoryName</td>
                            <td>@NewsStatuses.Label(news.Status)</td>
                            <td>@news.UpdatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="admin-table-actions">
                                <a class="btn btn-outline-secondary btn-sm" asp-controller="Journalist" asp-action="Edit" asp-route-id="@news.Id">Sửa</a>
                                <a class="btn btn-danger btn-sm" asp-controller="Journalist" asp-action="DeleteConfirm" asp-route-id="@news.Id">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
