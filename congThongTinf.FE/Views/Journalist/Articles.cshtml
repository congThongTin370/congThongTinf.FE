@{
    Layout = "_JournalistLayout";
    ViewData["Title"] = "Quản lý bài báo";
}

<div class="admin-page-header">
    <h1 class="admin-page-title">Quản lý bài báo</h1>
    <button type="button" class="btn btn-primary btn-sm" disabled>Viết bài mới</button>
</div>

<section class="admin-panel" aria-labelledby="articles-title">
    <div class="admin-panel-header">
        <h2 id="articles-title">Danh sách bài báo</h2>
    </div>
    <div class="admin-panel-body admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Tiêu đề</th>
                    <th scope="col">Chuyên mục</th>
                    <th scope="col">Trạng thái</th>
                    <th scope="col">Cập nhật</th>
                    <th scope="col" class="admin-table-actions">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" class="admin-table-empty">Chưa có bài báo nào.</td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
