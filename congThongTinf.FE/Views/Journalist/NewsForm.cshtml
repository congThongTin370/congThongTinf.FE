@model congThongTinf.FE.Models.ApiModels.NewsFormViewModel
@{
    Layout = "_JournalistLayout";
    var isEdit = Model.Id.HasValue;
    var pageTitle = isEdit ? "Sửa bài viết" : "Tạo bài viết mới";
    var selectedCategoryMissing = Model.CategoryId.HasValue
        && Model.Categories.All(category => category.Id != Model.CategoryId);
}

<div class="composer-page">
    <header class="composer-header">
        <nav class="composer-crumb" aria-label="Đường dẫn">
            <a asp-controller="Journalist" asp-action="Articles">Quản lý bài báo</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@pageTitle</span>
        </nav>
        <div class="composer-heading">
            <h1 class="admin-page-title">@pageTitle</h1>
            <div class="composer-status-row">
                <span class="admin-badge">@(Model.StatusLabel ?? NewsStatuses.PostedLabel)</span>
            </div>
        </div>
    </header>

    <form asp-controller="Journalist" asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="composer-form" id="news-composer-form">
        <input type="hidden" asp-for="StatusLabel" />
        <input type="hidden" asp-for="CategoryName" />

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="composer-layout">
            <div class="composer-main">
                <section class="composer-canvas" aria-label="Nội dung bài viết">
                    <div class="admin-form-field composer-title-field">
                        <label asp-for="Title"></label>
                        <input asp-for="Title" class="form-control composer-title" maxlength="300" placeholder="Nhập tiêu đề bài viết" data-news-title />
                        <span asp-validation-for="Title" class="field-validation-error"></span>
                    </div>

                    <div class="admin-form-field">
                        <label asp-for="Summary"></label>
                        <textarea asp-for="Summary" class="form-control composer-summary" rows="3" maxlength="1000" placeholder="Tóm tắt ngắn hiển thị ở danh sách tin (không bắt buộc)"></textarea>
                        <span asp-validation-for="Summary" class="field-validation-error"></span>
                    </div>

                    <div class="composer-slug-row">
                        <label class="composer-slug-label" for="news-slug">Đường dẫn</label>
                        <input id="news-slug" class="composer-slug-input" type="text" readonly tabindex="-1" data-news-slug aria-describedby="news-slug-hint" />
                    </div>
                    <p id="news-slug-hint" class="admin-field-hint">Tự động tạo từ tiêu đề.</p>

                    <div class="admin-form-field">
                        <span class="composer-label" id="cover-label">Ảnh đại diện</span>
                        <div class="composer-cover" data-cover>
                            <div class="composer-cover-preview" data-cover-preview>
                                <p class="composer-cover-empty" data-cover-empty>Chưa có ảnh đại diện</p>
                                <img alt="" hidden data-cover-image />
                            </div>
                            <div class="composer-cover-toolbar">
                                <button type="button" class="btn btn-outline-secondary btn-sm" data-cover-upload>Tải ảnh lên</button>
                                <input asp-for="CoverImageUrl" type="hidden" data-cover-url />
                                <input asp-for="CoverImage" type="file" accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" hidden data-cover-file />
                            </div>
                            <span asp-validation-for="CoverImage" class="field-validation-error"></span>
                            <p class="admin-field-hint">@(isEdit ? "Chọn ảnh mới để thay ảnh bìa. Không chọn thì giữ ảnh hiện tại." : "Ảnh jpg, jpeg, png, webp hoặc gif, tối đa 10 MB.")</p>
                        </div>
                    </div>

                    <div class="admin-form-field composer-editor-field">
                        <span class="composer-label" id="news-editor-label">Nội dung</span>
                        <div class="rich-editor" data-rich-editor data-upload-url="@Url.Action("UploadImage", "Journalist")">
                            <div class="rich-editor-toolbar" role="toolbar" aria-label="Công cụ định dạng">
                                <button type="button" class="rich-editor-btn" data-cmd="bold" title="In đậm" aria-label="In đậm">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h8a4 4 0 0 1 0 8H6zM6 12h9a4 4 0 0 1 0 8H6z"/></svg>
                                </button>
                                <button type="button" class="rich-editor-btn" data-cmd="italic" title="In nghiêng" aria-label="In nghiêng">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 4h-9M14 20H5M15 4L9 20"/></svg>
                                </button>
                                <span class="rich-editor-sep" aria-hidden="true"></span>
                                <button type="button" class="rich-editor-btn" data-cmd="h2" title="Tiêu đề lớn" aria-label="Tiêu đề lớn">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h8M4 5v14M12 5v14M16 8c0-1.5 1.5-2.5 3-2.5s3 1 3 2.5c0 3-6 5-6 9h6"/></svg>
                                </button>
                                <button type="button" class="rich-editor-btn" data-cmd="h3" title="Tiêu đề nhỏ" aria-label="Tiêu đề nhỏ">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h8M4 5v14M12 5v14M16 9.5c.8-.8 1.8-1.2 3-1.2 1.6 0 2.5.9 2.5 2s-1 1.8-2.5 1.8c1.5 0 2.5.7 2.5 1.9s-1 2.1-2.5 2.1c-1.2 0-2.2-.4-3-1.2"/></svg>
                                </button>
                                <span class="rich-editor-sep" aria-hidden="true"></span>
                                <button type="button" class="rich-editor-btn" data-cmd="ul" title="Danh sách dấu đầu dòng" aria-label="Danh sách dấu đầu dòng">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1.2"/><circle cx="4.5" cy="12" r="1.2"/><circle cx="4.5" cy="18" r="1.2"/></svg>
                                </button>
                                <button type="button" class="rich-editor-btn" data-cmd="ol" title="Danh sách đánh số" aria-label="Danh sách đánh số">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 6h10M10 12h10M10 18h10M4 4.5l1.5-1v5M3.5 14.5a1.5 1.5 0 0 1 3 0c0 1.5-3 2.5-3 4.5h3"/></svg>
                                </button>
                                <button type="button" class="rich-editor-btn" data-cmd="quote" title="Trích dẫn" aria-label="Trích dẫn">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6v12M9 8h11M9 12h11M9 16h7"/></svg>
                                </button>
                                <span class="rich-editor-sep" aria-hidden="true"></span>
                                <button type="button" class="rich-editor-btn" data-cmd="link" title="Liên kết" aria-label="Liên kết">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 11a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"/></svg>
                                </button>
                                <button type="button" class="rich-editor-btn" data-cmd="image" title="Chèn ảnh" aria-label="Chèn ảnh">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 8"/></svg>
                                </button>
                                <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden data-image-file />
                            </div>
                            <div class="rich-editor-content" id="news-editor" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Nội dung bài viết" data-editor-surface></div>
                            <textarea asp-for="Content" hidden data-content-editor></textarea>
                        </div>
                        <p class="admin-field-hint" data-image-status role="status" aria-live="polite"></p>
                        <span asp-validation-for="Content" class="field-validation-error"></span>
                    </div>
                </section>
            </div>

            <aside class="composer-side" aria-label="Cài đặt bài viết">
                <section class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Chuyên mục</h2>
                    </div>
                    <div class="admin-panel-body composer-panel-body">
                        <div class="admin-form-field">
                            <label asp-for="CategoryId" class="visually-hidden"></label>
                            <select asp-for="CategoryId" class="form-select">
                                <option value="">Chọn chuyên mục</option>
                                @if (selectedCategoryMissing)
                                {
                                    <option value="@Model.CategoryId">@(string.IsNullOrWhiteSpace(Model.CategoryName) ? "Chuyên mục hiện tại" : Model.CategoryName)</option>
                                }
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                            <span asp-validation-for="CategoryId" class="field-validation-error"></span>
                            @if (Model.Categories.Count == 0)
                            {
                                <p class="admin-field-hint">Chưa có chuyên mục đang hoạt động.</p>
                            }
                        </div>
                    </div>
                </section>

                <section class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Loại bài viết</h2>
                    </div>
                    <div class="admin-panel-body composer-panel-body">
                        <div class="admin-form-field">
                            <label class="visually-hidden" for="news-type">Loại bài viết</label>
                            <select id="news-type" class="form-select" data-news-type>
                                <option value="">Chọn loại bài viết</option>
                                <option>Tin tức</option>
                                <option>Phóng sự</option>
                                <option>Phỏng vấn</option>
                                <option>Bình luận</option>
                                <option>Thông báo</option>
                            </select>
                            <p class="admin-field-hint">Chỉ dùng khi soạn. Hệ thống chưa lưu loại bài.</p>
                        </div>
                    </div>
                </section>

                <section class="admin-panel">
                    <div class="admin-panel-header">
                        <h2>Tác giả</h2>
                    </div>
                    <div class="admin-panel-body composer-panel-body">
                        <div class="admin-form-field">
                            <label class="visually-hidden" for="news-author">Tác giả</label>
                            <input id="news-author" class="form-control" value="@Model.AuthorName" readonly />
                            <p class="admin-field-hint">Gắn theo tài khoản đang đăng nhập.</p>
                        </div>
                    </div>
                </section>

            </aside>
        </div>

        <div class="composer-actions">
            <div class="composer-actions-end">
                <button type="button" class="btn btn-outline-secondary" data-preview-open data-preview-url="@Url.Action("PreviewContent", "Journalist")">Xem trước</button>
                <button type="submit" class="btn btn-primary">@(isEdit ? "Cập nhật bài" : "Đăng bài")</button>
            </div>
        </div>

        <div class="app-dialog" id="preview-dialog" data-dialog-root>
            <div class="app-dialog-backdrop" data-dialog-dismiss></div>
            <div class="app-dialog-panel app-dialog-panel-wide" role="dialog" aria-modal="true" aria-labelledby="preview-dialog-title">
                <div class="app-dialog-header">
                    <h2 id="preview-dialog-title" class="app-dialog-title">Xem trước</h2>
                    <button type="button" class="app-dialog-close" data-dialog-close aria-label="Đóng">&times;</button>
                </div>
                <div class="app-dialog-body">
                    <article class="composer-preview" data-preview-article>
                        <p class="composer-preview-kicker" data-preview-kicker></p>
                        <h3 class="composer-preview-title" data-preview-title>Chưa có tiêu đề</h3>
                        <p class="composer-preview-summary" data-preview-summary hidden></p>
                        <figure class="composer-preview-cover" data-preview-figure hidden>
                            <img alt="" data-preview-image />
                        </figure>
                        <div class="composer-preview-body" data-preview-body></div>
                    </article>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/rich-editor.js" asp-append-version="true"></script>
    <script src="~/js/news-composer.js" asp-append-version="true"></script>
}
