@using congThongTinf.FE.Models.ApiModels
@model UserDto?

@{
    Layout = "_JournalistLayout";
    ViewData["Title"] = "Trang cá nhân";
}

<h1 class="admin-page-title">Thông tin cá nhân</h1>

<section class="admin-panel" aria-labelledby="profile-title">
    <div class="admin-panel-header">
        <h2 id="profile-title">Hồ sơ phóng viên</h2>
    </div>
    <div class="admin-panel-body">
        @if (Model == null)
        {
            <p class="admin-empty">Không tải được thông tin tài khoản. Vui lòng thử lại sau.</p>
        }
        else
        {
            <dl class="admin-detail">
                <dt>Họ và tên</dt>
                <dd>@Model.FullName</dd>

                <dt>Vai trò</dt>
                <dd>Phóng viên</dd>

                <dt>Email</dt>
                <dd>@Model.Email</dd>

                <dt>Tên đăng nhập</dt>
                <dd>@Model.Username</dd>

                <dt>Trạng thái tài khoản</dt>
                <dd>@(Model.IsActive ? "Đang hoạt động" : "Đã khóa")</dd>

                <dt>Ngày tạo tài khoản</dt>
                <dd>@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy")</dd>
            </dl>
        }
    </div>
</section>

<section class="admin-panel admin-section-gap" aria-labelledby="profile-stats-title">
    <div class="admin-panel-header">
        <h2 id="profile-stats-title">Thống kê bài viết</h2>
    </div>
    <div class="admin-panel-body">
        <div class="admin-stat-grid admin-stat-grid-compact">
            <div class="admin-stat-card admin-stat-card-news">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h12a3 3 0 0 1 3 3v11H7a3 3 0 0 1-3-3V5z"/><path d="M8 9h8M8 13h6"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Tổng bài</p>
                    <p class="admin-stat-value">@(ViewBag.ArticleCount ?? 0)</p>
                </div>
            </div>
            <div class="admin-stat-card admin-stat-card-categories">
                <span class="admin-stat-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5v14"/></svg>
                </span>
                <div class="admin-stat-copy">
                    <p class="admin-stat-label">Đã đăng</p>
                    <p class="admin-stat-value">@(ViewBag.PostedCount ?? 0)</p>
                </div>
            </div>
        </div>
    </div>
</section>
