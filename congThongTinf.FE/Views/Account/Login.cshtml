@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="login-panel" aria-labelledby="login-title">
    <h1 id="login-title">Đăng nhập</h1>
    <p class="login-lead">Dùng email và mật khẩu được cấp để vào cổng thông tin.</p>

    <form asp-controller="Account" asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <div class="login-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Email"></span>
        </div>

        <div class="login-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Password"></span>
        </div>

        <button type="submit" class="btn btn-primary login-submit">Đăng nhập</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
